DATABASE_URL="postgresql://user:password@localhost:5432/aqua?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generá uno único (nunca subas el valor real al repo):
#   openssl rand -hex 32
#   o en PowerShell:
#   [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]]).ToLower()
NEXTAUTH_SECRET=""

# Google OAuth (registro / login clientes)
# https://console.cloud.google.com/apis/credentials
# URIs de redirección autorizados (exacto, sin barra final):
#   https://www.aquaremates.com.ar/api/auth/callback/google
# Origen JavaScript autorizado:
#   https://www.aquaremates.com.ar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Login staff oculto (sin link en la tienda).
# Debe coincidir con la carpeta en src/app/(staff)/… (sin barra inicial).
# Default: login-aquaremates_administracion
STAFF_LOGIN_PATH="login-aquaremates_administracion"

# API de consulta de envíos (QR en ticket). OBLIGATORIA: sin esta clave el endpoint
# responde 503 (no queda abierto). Las apps externas deben enviar
# Authorization: Bearer <clave> o header X-Shipping-Key.
SHIPPING_LOOKUP_KEY=""

# JWT para app de riders (mapas). Si no se define, usa NEXTAUTH_SECRET.
# RIDER_JWT_SECRET=""
# (legacy, ya no se usa en login) STAFF_BRANCH_KEY="rematesaqua_sc01"
# Cuenta owner (solo entorno / secrets del hosting). Sin estos valores no se auto-crea admin.
# Nunca commitees contraseñas reales.
DEFAULT_OWNER_NAME="Administrador"
DEFAULT_OWNER_EMAIL=""
DEFAULT_OWNER_PASSWORD=""
# Vendedor opcional (también solo vía entorno)
# DEFAULT_SELLER_NAME="Vendedor"
# DEFAULT_SELLER_EMAIL=""
# DEFAULT_SELLER_PASSWORD=""
# Solo desarrollo local (NUNCA en Railway/produccion): preview sin login en /admin
# BACKOFFICE_PREVIEW="true"

# Emails transaccionales (EnvialoSimple / DonWeb)
# Panel: https://envialosimple.com → Dominios → Claves API
ENVIALOSIMPLE_API_KEY=""
# Debe ser un mail del dominio verificado en EnvialoSimple:
EMAIL_FROM="AQUA <ventas@aquaremates.com.ar>"

# Railway/Postgres (produccion)
# 1) Crear Postgres en Railway
# 2) Copiar DATABASE_URL al servicio web
# 3) Setear NEXTAUTH_URL a tu URL publica (ej. https://www.aquaremates.com.ar )
#    PUBLIC_APP_URL (opcional): URL canónica para mails y verificación. Si no está, los enlaces
#    de email usan www automáticamente para aquaremates.com.ar.

# Dominio propio (aquaremates.com.ar en Donweb + Railway)
# - En Railway: Settings → Networking → Custom Domain → agregar aquaremates.com.ar y www.aquaremates.com.ar
# - En Donweb DNS: CNAME @ → hcjr018j.up.railway.app (o el host que muestre Railway)
# - TXT _railway-verify → valor que muestra Railway (verificacion SSL)
# - En Railway variables: NEXTAUTH_URL="https://www.aquaremates.com.ar"
#   PUBLIC_APP_URL="https://www.aquaremates.com.ar"  (recomendado para mails)
# - Google OAuth: agregar https://www.aquaremates.com.ar/api/auth/callback/google

# Imagenes persistentes (Railway)
# Recomendado: montar un Volume en el servicio web apuntando a la carpeta:
#   <repo>/public/uploads/products
# y NO hace falta tocar nada (dejá AQUA_UPLOADS_DIR vacío).
# Si por alguna razón querés otra ruta en disco, usá ruta absoluta:
# AQUA_UPLOADS_DIR="/ruta/absoluta/uploads/products"

# Imagenes en produccion (recomendado: Cloudinary)
# En Railway, en el servicio web:
# STORAGE="cloudinary"  (recomendado en Railway: comprobantes + fotos de productos)
# CLOUDINARY_RECEIPTS_FOLDER="aqua/receipts"
# CLOUDINARY_CLOUD_NAME="tu_cloud_name"
# Y una de estas dos opciones:
# CLOUDINARY_UNSIGNED_PRESET="..."   # subida "unsigned" con upload preset
# o firma con API (sin preset hace falta key+secret):
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
# (opcional) CLOUDINARY_FOLDER="aqua/products"
# CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud_name>"  # alternativa a CLOUDINARY_CLOUD_NAME

# Mercado Pago (checkout minorista)
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# Produccion: Access Token de produccion. Pruebas: token de la pestaña "Credenciales de prueba".
MERCADOPAGO_ACCESS_TOKEN=""
# Clave secreta del webhook (panel MP → Webhooks → clave de firma). Recomendado en producción.
# MERCADOPAGO_WEBHOOK_SECRET=""
# Mientras uses credenciales de prueba, dejá en true (usa checkout sandbox y tarjetas de prueba):
MERCADOPAGO_SANDBOX="true"
# Al pasar a cobros reales: MERCADOPAGO_SANDBOX="false" + token de Producción.
# NEXTAUTH_URL debe ser la URL publica HTTPS (webhook y redirecciones de pago).

# Mercado Libre — importar 1 artículo por link en el alta de productos (admin)
# 1) Creá una app en https://developers.mercadolibre.com.ar
# 2) Obtené un Access Token (OAuth de tu usuario de prueba o producción)
# 3) Pegá el token acá / en Railway. Sin esto, el botón "Traer de Mercado Libre" falla.
# MELI_ACCESS_TOKEN=""

# Protección anti-bots (Cloudflare Turnstile — gratis)
# https://dash.cloudflare.com → Turnstile → Add site → dominio aquaremates.com.ar
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Libro de quejas online (destino del mail). Si no está, se loguea en consola.
# COMPLAINTS_TO_EMAIL="quejas@tudominio.com"

# Cron de retención de datos (cuentas sin verificar, etc.)
# CRON_SECRET=""

# Seed demo en producción (solo si lo necesitás una vez)
# SETUP_SECRET=""
