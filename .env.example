DATABASE_URL="postgresql://user:password@localhost:5432/aqua?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="1baab0bcfb3207cbc8a11f897e66679b1109b72911c29baa982a21bb9b36bb3d"

# Google OAuth (registro / login clientes)
# https://console.cloud.google.com/apis/credentials
# Tipo: OAuth 2.0 - ID de cliente web
# URIs de redireccion autorizados: https://TU-DOMINIO/api/auth/callback/google
# En local: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Mismo client id en el front (para mostrar botón Google). Puede ser igual a GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Login staff oculto (sin link en la tienda). Ej: login-aquaremates_administracion
STAFF_LOGIN_PATH="login-aquaremates_administracion"

# API de consulta de envíos (QR en ticket). Opcional: si se define, las apps externas deben enviar
# Authorization: Bearer <clave> o header X-Shipping-Key
# SHIPPING_LOOKUP_KEY=""

# JWT para app de riders (mapas). Si no se define, usa NEXTAUTH_SECRET.
# RIDER_JWT_SECRET=""
# (legacy, ya no se usa en login) STAFF_BRANCH_KEY="rematesaqua_sc01"
DEFAULT_OWNER_NAME="Administrador principal"
DEFAULT_OWNER_EMAIL="admin@aqua.local"
DEFAULT_OWNER_PASSWORD="Admin123456!"
DEFAULT_SELLER_NAME="Vendedor"
DEFAULT_SELLER_EMAIL="vendedor@aqua.local"
DEFAULT_SELLER_PASSWORD="Vendedor123!"
# Mientras no uses login: permite entrar a /admin y /vendedor y APIs admin sin sesion
# Valores aceptados: true, 1, yes, si (tambien NEXT_PUBLIC_BACKOFFICE_PREVIEW en Vercel)
BACKOFFICE_PREVIEW="true"
NEXT_PUBLIC_BACKOFFICE_PREVIEW="true"

# Railway/Postgres (produccion)
# 1) Crear Postgres en Railway
# 2) Copiar DATABASE_URL al servicio web
# 3) Setear NEXTAUTH_URL a tu URL publica (ej. https://aquaremates.com.ar )

# Dominio propio (aquaremates.com.ar en Donweb + Railway)
# - En Railway: Settings → Networking → Custom Domain → agregar aquaremates.com.ar y www.aquaremates.com.ar
# - En Donweb DNS: CNAME @ → hcjr018j.up.railway.app (o el host que muestre Railway)
# - TXT _railway-verify → valor que muestra Railway (verificacion SSL)
# - En Railway variables: NEXTAUTH_URL="https://aquaremates.com.ar"
# - Google OAuth: agregar https://aquaremates.com.ar/api/auth/callback/google

# Imagenes persistentes (Railway)
# Recomendado: montar un Volume en el servicio web apuntando a la carpeta:
#   <repo>/public/uploads/products
# y NO hace falta tocar nada (dejá AQUA_UPLOADS_DIR vacío).
# Si por alguna razón querés otra ruta en disco, usá ruta absoluta:
# AQUA_UPLOADS_DIR="/ruta/absoluta/uploads/products"

# Imagenes en produccion (recomendado: Cloudinary)
# En Railway, en el servicio web:
# STORAGE="cloudinary"
# CLOUDINARY_CLOUD_NAME="tu_cloud_name"
# Y una de estas dos opciones:
# CLOUDINARY_UNSIGNED_PRESET="..."   # subida "unsigned" con upload preset
# o firma con API (sin preset hace falta key+secret):
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
# (opcional) CLOUDINARY_FOLDER="aqua/products"
# CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud_name>"  # alternativa a CLOUDINARY_CLOUD_NAME

# Mercado Pago (checkout minorista)
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# Produccion: Access Token de produccion. Pruebas: token de prueba (TEST-...).
MERCADOPAGO_ACCESS_TOKEN=""
# NEXTAUTH_URL debe ser la URL publica HTTPS (webhook y redirecciones de pago).
